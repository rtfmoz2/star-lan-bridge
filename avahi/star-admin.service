<?xml version="1.0" standalone='no'?>
<!DOCTYPE service-group SYSTEM "avahi-service.dtd">
<!-- Advertises the printer bridge web page over Bonjour as "Printer bridge on <host>". -->
<service-group>
  <name replace-wildcards="yes">Printer bridge on %h</name>
  <service>
    <type>_http._tcp</type>
    <port>80</port>
    <txt-record>path=/</txt-record>
  </service>
</service-group>
